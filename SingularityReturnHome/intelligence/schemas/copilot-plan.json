{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "singularos://schemas/copilot-plan.json",
  "title": "AI copilot recovery plan",
  "description": "A multi-step recovery plan proposed by the AI copilot. The copilot proposes only; the deterministic plan validator checks every step before the controller may execute it (MISSION.md section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment", "decision", "steps", "advisories_considered", "rationale"],
  "properties": {
    "schema_version": {"const": 1},
    "assessment": {
      "description": "What happened and what still works, in the copilot's own words, citing evidence.",
      "type": "string", "minLength": 1, "maxLength": 500
    },
    "decision": {"enum": ["DOCK", "HOLD", "ABORT"]},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "action": {"enum": ["RETURN_TO_STAGING", "GOTO", "PREDOCK_STOP", "COAST_IN", "FINAL_APPROACH", "HOLD_AT", "SAFE_STOP"]},
          "x_m": {"type": "number", "minimum": -200, "maximum": 200},
          "y_m": {"type": "number", "minimum": -200, "maximum": 200},
          "speed_m_s": {"type": "number", "minimum": 0, "maximum": 0.5}
        }
      }
    },
    "advisories_considered": {
      "description": "Ids of the station advisories this plan follows.",
      "type": "array", "maxItems": 6,
      "items": {"type": "string", "maxLength": 40}
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
