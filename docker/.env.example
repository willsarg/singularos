# SingularOS development environment: Omarchy desktop + local LLM runtime.
#
# Copy to .env and adjust. No secrets required for local use.

# --- Omarchy VM ---
# RAM and CPU allocated to the QEMU guest.
MEMORY=8G
CPUS=4
# noVNC browser display (localhost only).
VNC_PORT=8900

# --- LLM (llama.cpp server) ---
# Host port for the OpenAI-compatible API (localhost only).
LLM_PORT=8080
# GGUF model file to load, relative to the models/ directory.
# Place any GGUF file in docker/models/ and set its name here.
LLM_MODEL=
# Context window and parallel slots.
LLM_CTX_SIZE=8192
LLM_PARALLEL=4
