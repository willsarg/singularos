{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "singularos",
  // Python Worker assembled by scripts/bundle-worker.mjs (pnpm run bundle-worker).
  "main": ".worker/entry.py",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "singularos.willsarg.com", "custom_domain": true }],
  // Static files are served directly; only /api/* runs the Worker.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Scenario TOML files and the proposal schema are read at runtime.
  "rules": [{ "type": "Data", "globs": ["**/*.toml", "**/*.json"], "fallthrough": true }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "RUN_LIMITER", "namespace_id": "2601", "simple": { "limit": 20, "period": 60 } },
    { "name": "ADVICE_LIMITER", "namespace_id": "2602", "simple": { "limit": 6, "period": 60 } }
  ],
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true }
}
